# ========================================================
# OKPO TICKETING APP - ENVIRONMENT VARIABLES TEMPLATE
# ========================================================
# Copy this file to .env and .env.local, then fill in your real values.

# Supabase Auth & API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Supabase PostgreSQL Database (Transaction Pooler - Port 6543)
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Database (Direct Connection - Port 5432)
DIRECT_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Paystack Gateway Keys
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_or_test_key_here
PAYSTACK_SECRET_KEY=sk_live_or_test_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# Application Settings
JWT_SECRET=generate_a_strong_random_string
FREE_THRESHOLD=50000
